APP_ENV=development
HTTP_ADDR=:8080
DATABASE_DSN=blog:blog@tcp(127.0.0.1:3306)/blog
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
JWT_TTL=168h
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# Proxies allowed to set X-Forwarded-For; the client IP drives comment rate limiting.
TRUSTED_PROXIES=127.0.0.1,::1
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
# Visitors cannot comment with this nickname or with ADMIN_EMAIL / NOTIFY_EMAIL.
ADMIN_NICKNAME=admin

SITE_NAME=My Blog
# Public address of the blog, used in notification emails. In production e.g. https://blog.example.com;
# the admin is then https://blog.example.com/admin/ and needs no extra ALLOWED_ORIGINS entry.
SITE_URL=http://localhost:3000

# Leave SMTP_HOST empty to disable email notifications. Port 465 uses implicit TLS.
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=
NOTIFY_EMAIL=

# S3-compatible storage (RustFS, MinIO, AWS S3, R2...) for admin image uploads; leave empty to disable.
# Use a key that can only write to OSS_BUCKET. The bucket needs a public-read policy and CORS allowing PUT
# from the admin origin.
OSS_ENDPOINT=https://oss.example.com
OSS_REGION=us-east-1
OSS_ACCESS_KEY_ID=
OSS_SECRET_ACCESS_KEY=
OSS_BUCKET=blog
# Public URL prefix for uploaded files; defaults to <endpoint>/<bucket>
OSS_PUBLIC_BASE_URL=
OSS_DIR=images

COMMENT_RATE_PER_MINUTE=3
COMMENT_BURST=3

# Built frontends served by this process (blog at /, admin at /admin/). The Docker image sets these;
# leave them unset in development, where the webpack dev servers on :3000 / :3001 are used instead.
# WEB_DIR=../web/build
# ADMIN_DIR=../web-admin/build

# Swagger UI at /api/docs/ and the spec at /api/openapi.yaml. Defaults to on in development and off
# when APP_ENV=production.
# API_DOCS=true

# Only used by the optional mysql service in ../docker-compose.yml (--profile mysql).
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=blog
MYSQL_USER=blog
MYSQL_PASSWORD=blog
